# ==========================================
# 🚀 FRIC Portal — Comprehensive .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
.next/
/out/
/build
.turbo/
dist/

# Environment Variables (CRITICAL: Never commit secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
!/.env.local.example
!/.env.example

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# IDEs & System Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.pem

# Vercel & Deployment
.vercel

# Temporary files
/tmp/
*.tmp
*.bak
